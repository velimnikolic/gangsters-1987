# Unity crash/report artefakti
sysinfo.txt
*.stackdump
crashlytics-build.properties

# Asset Store tools i addressables build
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# macOS
.DS_Store

# Editor dump artefakti
LedgerDump_*.txt

# RoadSim headless harness (Tools/RoadSim): its project file is ours, its build output is not
!Tools/RoadSim/RoadSim.csproj
Tools/RoadSim/bin/
Tools/RoadSim/obj/

# Claude Code local state (project settings.json is tracked)
.claude/settings.local.json
.claude/worktrees/

# Unity mono crash dumps
mono_crash.*.json

# Unity review gate state (per-fingerprint review markers)

# Tools/CoreSim (dotnet, offline core-layout loop): keep the project, drop the build
Tools/CoreSim/bin/
Tools/CoreSim/obj/
!Tools/CoreSim/CoreSim.csproj

# Scratch of a working session: probe scripts, screenshots, the accidental dev/null
dev/
# Editor screenshot dumps
Assets/Logs/
Assets/Logs.meta

# ledger web design system (design-sync)
Tools/ledger-ds/node_modules/
Tools/ledger-ds/dist/
Tools/ledger-ds/.ds-sync/
Tools/ledger-ds/ds-bundle/
Tools/ledger-ds/.design-sync/.cache/
Tools/ledger-ds/.design-sync/learnings/
Tools/ledger-ds/.design-sync/node_modules

# Unity's own extraction of an FBX's embedded textures (.fbm): a build product, and a
# byte-for-byte duplicate of the Ch15 Textures folder next to it
/Assets/Animations/Mixamo/Rifle/*.fbm/
/Assets/Animations/Mixamo/Rifle/*.fbm.meta

# Python bytecode from the play-harness tools
__pycache__/
*.pyc
